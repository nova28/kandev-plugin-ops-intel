.build/
server/

# Extractor output and Rill's local DuckDB scratch — both regenerated by
# `rill/extract/extract.sh` and `rill start`, and both hold real telemetry.
rill/data/
rill/tmp/

# Python bytecode from rill/extract helpers
__pycache__/
*.pyc

# Persisted session -> card attribution (ids only); outlives the transcripts it is derived from.
rill/state/
